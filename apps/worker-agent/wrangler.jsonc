{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "raycast-agent-orchestrator",
  "main": "src/agent.ts",
  "type": "service",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "env": {
    "production": {
      "name": "raycast-agent-orchestrator-prod",
      "routes": [
        {
          "pattern": "orchestrator.zbst.tech/*",
          "zone_name": "zbst.tech"
        }
      ]
    },
    "staging": {
      "name": "raycast-agent-orchestrator-staging",
      "routes": [
        {
          "pattern": "orchestrator-staging.zbst.tech/*",
          "zone_name": "zbst.tech"
        }
      ]
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "Supervisor",
        "class_name": "Supervisor"
      },
      {
        "name": "ResearcherAgent",
        "class_name": "ResearcherAgent"
      },
      {
        "name": "PlannerAgent",
        "class_name": "PlannerAgent"
      },
      {
        "name": "TreeAgent",
        "class_name": "TreeAgent"
      },
      {
        "name": "WorktreeAgent",
        "class_name": "WorktreeAgent"
      },
      {
        "name": "RaycastAgent",
        "class_name": "RaycastAgent"
      },
      {
        "name": "InferenceAgent",
        "class_name": "InferenceAgent"
      },
      {
        "name": "ManifestAgent",
        "class_name": "ManifestAgent"
      },
      {
        "name": "TerminalAgent",
        "class_name": "TerminalAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Supervisor",
        "ResearcherAgent",
        "PlannerAgent",
        "TreeAgent",
        "WorktreeAgent",
        "RaycastAgent",
        "InferenceAgent",
        "ManifestAgent",
        "TerminalAgent"
      ]
    }
  ],
  "build": {
    "command": "npm run build",
    "cwd": "."
  }
}
