{
  "name": "raycast-agent-orchestration",
  "version": "0.1.0",
  "description": "Raycast agent orchestration system for chat-tree branching, git worktrees, subagents, local inference",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "bootstrap": "bash scripts/bootstrap-full.sh",
    "export-manifest": "ts-node scripts/export-manifest.ts",
    "sync-tree": "ts-node scripts/sync-tree.ts",
    "validate": "ts-node scripts/validate-tree.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
