<plist version="1.0"><dict>
  <key>Label</key><string>com.pv.raycast-agent.pplx-handback</string>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/pv/dev/raycast-agent-orchestration/scripts/pplx/handback-writer.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/pv/dev/raycast-agent-orchestration</string>
